///|
fn fixture_profile(name : String) -> Bytes {
  match name {
    "srgb_v4_rel" => b64decode(icc_srgb_v4_rel)
    "srgb_linear_v4_rel" => b64decode(icc_srgb_linear_v4_rel)
    "gray_linear_v4" => b64decode(icc_gray_linear_v4)
    "gray_srgb_v4" => b64decode(icc_gray_srgb_v4)
    "brg_v2_curv" => b64decode(icc_brg_v2_curv)
    "rgb_v4_lutab" => b64decode(icc_rgb_v4_lutab)
    "cmyk_v2_lut" => b64decode(icc_cmyk_v2_lut)
    "rgb_v2_lut_lab" => b64decode(icc_rgb_v2_lut_lab)
    "rgb_v4_mixed_trc" => b64decode(icc_rgb_v4_mixed_trc)
    "gray_v4_para" => b64decode(icc_gray_v4_para)
    "gray_v2_gamma" => b64decode(icc_gray_v2_gamma)
    "mch5_v4" => b64decode(icc_mch5_v4)
    "two_v4" => b64decode(icc_two_v4)
    "gray_v4_clut" => b64decode(icc_gray_v4_clut)
    _ => abort("unknown profile")
  }
}

