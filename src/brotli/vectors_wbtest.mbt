///|
test "decompress 10x10y.compressed" {
  let b64 =
    #|GxMAAKSwsuqBRwKK
  let data = decode_base64(b64)
  let out = decompress(data)
  assert_eq(out.length(), 20)
  assert_eq(fnv1a(out), 599845655U)
}

