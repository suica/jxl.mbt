///|
test "decompress ukkonooa.compressed" {
  let b64 =
    #|G3YAABRKrJt6veGXnX+OwoI2DpzgkAP3i5445rYAq8PKoMLaZjbczYCNLiHXbuPqTLjw0rjHwnBNOvBpfqG4RXOrxFce
  let data = decode_base64(b64)
  let out = decompress(data)
  assert_eq(out.length(), 119)
  assert_eq(fnv1a(out), 406270837U)
}

///|
test "decompress x.compressed" {
  let b64 =
    #|CwCAWAM=
  let data = decode_base64(b64)
  let out = decompress(data)
  assert_eq(out.length(), 1)
  assert_eq(fnv1a(out), 3708558887U)
}

