  for case in cases {
    let (mult, n, bits, vals) = case
    let bs = @bitstream.Bitstream::new(hex_to_bytes(data))
    let dec = @coding.Decoder::parse(bs, 1)
    let out : Array[UInt32] = []
    for _ in 0..<200 {
      let v = dec.read_varint_with_multiplier(bs, 0, mult) catch { _ => break }
      out.push(v)
    }
    assert_eq(out.length(), n)
    assert_eq(bs.num_read_bits(), bits)
    assert_eq(out, vals)
  }
