    1, -2, -1, -1, -1, -2, -1, -1,
  ]
  let q : FixedArray[Int32] = [
    4, 3, 3, 4, 6, 7, 8, 10, 3, 3, 3, 4, 5, 6, 8, 10, 3, 3, 3, 4, 6, 9, 12, 12, 4,
    4, 4, 7, 9, 12, 12, 12, 6, 5, 6, 9, 12, 12, 12, 12, 7, 6, 9, 12, 12, 12, 12,
    12, 8, 8, 12, 12, 12, 12, 12, 12, 10, 10, 12, 12, 12, 12, 12, 12,
  ]
  let dc_grid = @grid.Grid::from_buf(25, 25, dc)
  let y = @grid.Grid::new(200, 200, 0)
  for i in 0..<ac_pos.length() {
    y.set(ac_pos[i] & 0xffff, ac_pos[i] >> 16, ac_val[i])
  }
  let zeros = @grid.Grid::new(200, 200, 0)
  let lf_zeros = @grid.Grid::new(25, 25, 0)
  let info : JpegFrameInfo = {
    image_width: 200,
    image_height: 200,
    width: 200,
    height: 200,
    color_sample_width: 200,
    color_sample_height: 200,
    jpeg_upsampling: [0, 0, 0],
    do_ycbcr: true,
    group_size_shift: 1,
  }
  let parsed : ParsedFrameData = {
    lf_quant: [[dc_grid, lf_zeros, lf_zeros]],
    pass_groups: [[y, zeros, zeros]],
    jpeg_quant_values: [q, q, q],
    dc_offset: [0, 0, 0],
  }
  let icc_b64 =
    #|AAADkEFEQkUCEAAAcHJ0ckdSQVlYWVogB88ABgADAAAAAAAAYWNzcEFQUEwAAAAAbm9uZQAAAAAAAAAAAAAAAAAAAAEAAPbWAAEA
    #|AAAA0y1BREJFAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAFY3BydAAAAMAAAAAyZGVzYwAA
    #|APQAAABnd3RwdAAAAVwAAAAUYmtwdAAAAXAAAAAUa1RSQwAAAYQAAAIMdGV4dAAAAABDb3B5cmlnaHQgMTk5OSBBZG9iZSBTeXN0
    #|ZW1zIEluY29ycG9yYXRlZAAAAGRlc2MAAAAAAAAADURvdCBHYWluIDMwJQAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
    #|AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWFlaIAAAAAAAAPbWAAEAAAAA0y1YWVogAAAA
    #|AAAAAAAAAAAAAAAAAGN1cnYAAAAAAAABAAAAABAAIAAwAEAAUABgAHAAgQCRAKEAsQDBANEA4QDxAQEBEQEhATEBQQFRAWEBcQGC
    #|AZIBogGyAcIB0gHiAfICEQI4AmECiwK3AuUDFQNGA3gDrQPjBBsEVASQBM0FDAVMBY8F0wYZBmEGqwb3B0UHlAfmCDkIjgjlCT4J
    #|mQn2ClUKtgsZC34L5QxODLkNJg2VDgcOeg7vD2cP4BBcENkRWRHbEl8S5hNuE/gUhRUUFaUWORbOF2YYABicGToZ2xp+GyMbyhx0
    #|HSAdzh5/HzIf5yCfIVgiFSLTI5QkVyUdJeUmryd8KEspHCnwKsYrnyx6LVcuNy8aL/8w5jHQMrwzqzScNY82hjd+OHk5dzp3O3o8
    #|fz2HPpE/nkCtQb9C1EPrRQVGIUdASGFJhUqsS9VNAU4vT2BQlFHKUwNUP1V9Vr5YAVlIWpFb3F0rXnxfz2EmYn9j2mU5Zppn/mll
    #|as5sOm2pbxtwj3IGc4B0/XZ9d/95hHsMfJZ+JH+0gUeC3YR1hhGHr4lQivSMm45Fj/GRoZNTlQiWwJh7mjmb+Z29n4OhTaMZpOim
    #|uqiPqmesQq4fsACx47PKtbO3oLmPu4K9d79vwWrDaMVqx27Jdct/zYzPnNGw08bV39f72hrcPd5i4IriteTk5xXpSuuB7bzv+fI6
    #|9H72xfkP+1z9rP//
  let recon = JpegBitstreamReconstructor::from_parsed(
    data.header(),
    data.data(),
    info,
    parsed,
    decode_base64(icc_b64),
    b"",
    b"",
  )
  let out = recon.to_bytes()
  assert_eq(out.length(), 9218)
  assert_eq(fnv1a(out), 975098654U)
}

///|
fn fnv1a(b : Bytes) -> UInt32 {
  let mut h = 0x811c9dc5U
  for x in b {
    h = (h ^ x.to_uint()) * 0x01000193U
  }
  h
}
