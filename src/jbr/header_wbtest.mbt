// jbrd boxes of conformance / jxl-oxide test images, with the marker list
// of the original JPEG. Generated by scripts-jbr/gen_jbr_header_test.py.

///|
test "jbrd header grayscale_jpeg" {
  let b64 =
    #|RXcDOkLLAh3AAQCEAICtEgAAUYxJ0IKhOP8niIwRSkhrlJBiOkI2A2oQdZiBhkp3sEOGG1A+ZshB2x72oEUGPmrowZfRD/v9keMO
    #|HH6ShZ5Z6shDj11suYOneWiTJRdd9hr/qceeW/jow4VLFjSUL8Z48MmJLnr02auWnuqTM45ffPmHn378+cmmm3DKSaedeOrJp7/s
    #|uguvvPTai6++/PptNtpqs+023HLTbTfeevPtv/noq8+++/DLT7/9+OvPvx9lnJHGGm28EcccddyRxx59/FPOOems08478cxTzz35
    #|7NPP/x/gBwDIAAAACweA7gAOQWRvYmUAZAAAAAAAAw==
  let jbrd = decode_base64(b64)
  let data = JpegBitstreamData::try_parse(jbrd).unwrap()
  data.finalize()
  assert_eq(data.header().markers, [226, 238, 219, 192, 221, 196, 218, 217])
  assert_eq(data.header().tail_data_length, 0)
  assert_eq(data.data().length(), data.header().expected_data_len())
}

