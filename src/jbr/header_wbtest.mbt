test "jbrd header cafe" {
  let b64 =
    #|QHHbAIIgCC0DAiDIgVCjQMglAACAIuRI6P8TRMbknFNSWskQhAxhljrIMO4hAw01WB4z3IBDyosMOuzA9kFHDf3IMocdN/jvzyx0
    #|4JGHHtv6JEstttzw0zy04JIHH33JNU899tyyi0401YOH+08+uvT/CqYSAABAyBCV/y8IIYTICCWFEEkgNHkQdZgYaCj3kGMGG64O
    #|GvB3eZFlhhx02IEHH3r4hY6yD8tnDjzyf4EfAKgsAAsIgOAAEEpGSUYAAQEAAAEAAQAAAw==
  let jbrd = decode_base64(b64)
  let data = JpegBitstreamData::try_parse(jbrd).unwrap()
  data.finalize()
  assert_eq(data.header().markers, [
    224, 226, 219, 219, 192, 196, 196, 196, 196, 218, 217,
  ])
  assert_eq(data.header().tail_data_length, 0)
  assert_eq(data.data().length(), data.header().expected_data_len())
}

