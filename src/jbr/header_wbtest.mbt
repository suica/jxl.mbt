  let jbrd = decode_base64(b64)
  let data = JpegBitstreamData::try_parse(jbrd).unwrap()
  data.finalize()
  assert_eq(data.header().markers, [
    226, 219, 194, 196, 218, 218, 218, 218, 218, 196, 218, 218, 196, 218, 196, 218,
    218, 196, 218, 196, 218, 218, 217,
  ])
  assert_eq(data.header().tail_data_length, 0)
  assert_eq(data.data().length(), data.header().expected_data_len())
}
