    #|0L8vctBRg7e9zGHDP3LcgUfqhy70zENLHewfu9hyC/4v8AMAlQUACwiA4AAQSkZJRgABAQAAAQABAAAD
  let jbrd = decode_base64(b64)
  let data = JpegBitstreamData::try_parse(jbrd).unwrap()
  data.finalize()
