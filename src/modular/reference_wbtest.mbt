///|
priv struct Rng {
  mut state : UInt64
}

///|
fn Rng::next(self : Rng) -> UInt32 {
  self.state = self.state * 6364136223846793005UL + 1442695040888963407UL
  (self.state >> 33).to_uint()
}

///|
fn Rng::range(self : Rng, lo : Int32, hi : Int32) -> Int32 {
  let span = (hi.to_int64() - lo.to_int64() + 1L).reinterpret_as_uint64()
  (lo.to_int64() + (self.next().to_uint64() % span).reinterpret_as_int64()).to_int()
}

///|
priv struct Hash {
  mut h : UInt32
}

///|
fn Hash::add(self : Hash, v : Int32) -> Unit {
  self.h = (self.h ^ v.reinterpret_as_uint()) * 16777619U
}

///|
fn rand_grid(
  rng : Rng,
  w : Int32,
  h : Int32,
  lo : Int32,
  hi : Int32,
  narrow~ : Bool = false,
) -> @grid.Grid[Int32] {
  let g = @grid.Grid::new(w, h, 0)
  for i in 0..<(w * h) {
    let v = if lo == -2147483648 && hi == 2147483647 {
      rng.next().reinterpret_as_int()
    } else {
      rng.range(lo, hi)
    }
    g.buf[i] = wrap_s(narrow, v)
  }
  g
}

///|
fn wp_custom() -> WpHeader {
  {
    default_wp: false,
    wp_p1: 5,
    wp_p2: 20,
    wp_p3a: 3,
    wp_p3b: 9,
    wp_p3c: 1,
    wp_p3d: 4,
    wp_p3e: 6,
    wp_w0: 15,
    wp_w1: 1,
    wp_w2: 7,
    wp_w3: 3,
  }
}

///|
let all_predictors : Array[Predictor] = [
  Zero,
  West,
  North,
  AvgWestAndNorth,
  Select,
  Gradient,
  SelfCorrecting,
  NorthEast,
  NorthWest,
  WestWest,
  AvgWestAndNorthWest,
  AvgNorthAndNorthWest,
  AvgNorthAndNorthEast,
  AvgAll,
]

///|
fn predictor_case(
  seed : UInt64,
  w : Int32,
  h : Int32,
  lo : Int32,
  hi : Int32,
  wp : WpHeader,
) -> UInt32 {
  let rng = { state: seed, }
  let data = rand_grid(rng, w, h, lo, hi)
  let p1 = rand_grid(rng, w, h, lo, hi)
  let p2 = rand_grid(rng, w, h, lo, hi)
  let prev = [p1.as_subgrid(), p2.as_subgrid()]
  let hash = { h: 2166136261U, }
  let state = PredictorState::new()
  state.reset(w, prev, Some(wp))
  for y in 0..<h {
    for x in 0..<w {
      state.properties()
      for p in 0..<26 {
        hash.add(state.get_property(p))
      }
      for pred in all_predictors {
        hash.add(pred.predict(state))
      }
      state.record(data.get(x, y))
    }
  }
  hash.h
}

///|
fn squeeze_case(
  seed : UInt64,
  w : Int32,
  h : Int32,
  lo : Int32,
  hi : Int32,
  horizontal : Bool,
  narrow~ : Bool = false,
) -> UInt32 {
  let rng = { state: seed, }
  let g = rand_grid(rng, w, h, lo, hi, narrow~)
  if horizontal {
    inverse_h(g.as_subgrid(), narrow)
  } else {
    inverse_v(g.as_subgrid(), narrow)
  }
  let hash = { h: 2166136261U, }
  for v in g.buf {
    hash.add(v)
  }
  hash.h
}

///|
fn rct_case(seed : UInt64, rct_type : Int32, narrow~ : Bool = false) -> UInt32 {
  let rng = { state: seed, }
  let a = rand_grid(rng, 5, 3, -2147483648, 2147483647, narrow~)
  let b = rand_grid(rng, 5, 3, -2147483648, 2147483647, narrow~)
  let c = rand_grid(rng, 5, 3, -2147483648, 2147483647, narrow~)
  let grids = [a, b, c].map(fn(g) { TransformedGrid::from(g.as_subgrid()) })
  Rct::inverse(
    { begin_c: 0, rct_type, },
    grids,
    @threadpool.JxlThreadPool::none(),
    if narrow {
      I16
    } else {
      I32
    },
  )
  let hash = { h: 2166136261U, }
  for g in [a, b, c] {
    for v in g.buf {
      hash.add(v)
    }
  }
  hash.h
}

///|
fn palette_case(
  seed : UInt64,
  num_c : Int32,
  nb_colours : Int32,
  nb_deltas : Int32,
  d_pred : Predictor,
  bit_depth : Int32,
  simple : Bool,
  narrow~ : Bool = false,
) -> UInt32 {
  let rng = { state: seed, }
  let pal : Palette = {
    begin_c: 0,
    num_c,
    nb_colours,
    nb_deltas,
    d_pred,
    wp_header: if d_pred == SelfCorrecting {
      Some(wp_custom())
    } else {
      None
    },
  }
  let palette = if narrow {
    rand_grid(rng, nb_colours, num_c, -32000, 32000, narrow=true)
  } else {
    rand_grid(rng, nb_colours, num_c, -300, 300)
  }
  let grids = Array::makei(num_c, fn(_) { rand_grid(rng, 9, 7, -5, 5) })
  let hi = if simple { nb_colours - 1 } else { nb_colours + 64 + 200 }
  let lo = if simple { 0 } else { -300 }
  for i in 0..<(9 * 7) {
    grids[0].buf[i] = rng.range(lo, hi)
  }
  pal.inverse_inner(
    palette.as_subgrid(),
    grids.map(fn(g) { g.as_subgrid() }),
    bit_depth,
    if narrow {
      I16
    } else {
      I32
    },
  )
  let hash = { h: 2166136261U, }
  for g in grids {
    for v in g.buf {
      hash.add(v)
    }
  }
  hash.h
}

///|
fn parse_int(s : String) -> Int32 {
  @string.parse_int(s) catch {
    _ => abort("bad int")
  }
}

///|
test "reference hashes from jxl-oxide" {
  assert_eq(run_reference(reference_data), 254)
}

///|
test "reference hashes from jxl-oxide (i16 samples)" {
  assert_eq(run_reference(reference_data_i16), 246)
}

///|
fn run_reference(data : String) -> Int32 raise {
  let mut count = 0
  for line in data.split("\n") {
    let f = line.split(" ").map(fn(s) { s.to_owned() }).collect()
    if f.length() < 2 {
      continue
    }
    let expected = @string.parse_uint(f[f.length() - 1])
    let seed = parse_int(f[1]).to_uint64()
    let narrow = f[0].has_suffix("16")
    let got = match f[0] {
      "predictor" => {
        let wp = if f[6] == "true" { wp_custom() } else { WpHeader::default() }
        predictor_case(
          seed,
          parse_int(f[2]),
          parse_int(f[3]),
          parse_int(f[4]),
          parse_int(f[5]),
          wp,
        )
      }
      "squeeze" | "squeeze16" =>
        squeeze_case(
          seed,
          parse_int(f[2]),
          parse_int(f[3]),
          parse_int(f[4]),
          parse_int(f[5]),
          f[6] == "true",
          narrow~,
        )
      "rct" | "rct16" => rct_case(seed, parse_int(f[2]), narrow~)
      "palette" | "palette16" =>
        palette_case(
          seed,
          parse_int(f[2]),
          parse_int(f[3]),
          parse_int(f[4]),
          all_predictors[parse_int(f[5])],
          parse_int(f[6]),
          f[7] == "true",
          narrow~,
        )
      _ => abort("unknown case")
    }
    assert_eq(got, expected, msg=line.to_owned())
    count += 1
  }
  count
}
