test "replay delta_palette" {
  let dump =
    #|G 79174 256 8 0 26871  555:751:S:0 555:751:S:0 555:751:S:0
    #|S 0:0:3
    #|P 0 0 21 0 112416 
    #|P 0 1 22 0 137232 
    #|P 0 2 23 0 15616 
    #|P 0 3 24 0 155696 
    #|P 0 4 25 0 162584 
    #|P 0 5 26 0 22872 
    #|P 0 6 27 0 99016 
    #|P 0 7 28 0 111360 
    #|P 0 8 29 0 19232 
    #|F 3 555:751:3964480214 555:751:27091050 555:751:1822895179
  let n = replay_dump(dump)
  assert_true(n > 0)
}
