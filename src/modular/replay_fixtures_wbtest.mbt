// Modular streams of conformance / jxl-oxide test images, dumped from an
// instrumented jxl-oxide 0.12.6 with the expected channel hashes (see
// replay_wbtest.mbt for the format).

///|
test "replay squeeze_edge" {
  let dump =
    #|G 66816 256 8 0 159 2500ecf2ff0b0109000490721e6073c93f74c81f 513:513:S:0 513:513:S:0 513:513:S:0 513:513:S:0
    #|S 0:1:3 1:0:1
    #|P 0 0 21 0 40 730dc4df01
    #|P 0 1 22 0 40 730dc4df01
    #|P 0 2 23 0 40 a3ca340100
    #|P 0 3 24 0 40 730dc4df01
    #|P 0 4 25 0 40 730dc4df01
    #|P 0 5 26 0 40 a3ca340100
    #|P 0 6 27 0 40 93a8390100
    #|P 0 7 28 0 40 93a8390100
    #|P 1 0 30 0 40 a343e3d90d
    #|P 1 1 31 0 40 a343e3d90d
    #|P 1 2 32 0 40 93a8390100
    #|P 1 3 33 0 40 a343e3d90d
    #|P 1 4 34 0 40 a343e3d90d
    #|P 1 5 35 0 40 93a8390100
    #|F 4 513:513:3151552078 513:513:2430586143 513:513:2430586143 513:513:3151552078
  let n = replay_dump(dump)
  assert_true(n > 0)
}

