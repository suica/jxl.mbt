//
// Port of `pow_exec.rs` (the parts reached by `f_pow`). `dd_fmla` is the
// not-fma `DoubleDouble::dd_f64_mul_add`.

///|
fn log_poly_1(z : Double) -> DoubleDouble {
  // The following is a degree-8 polynomial generated by Sollya for
  // log(1+x)-x+x^2/2 over [-0.0040283203125,0.0040283203125]
  // with absolute error < 2^-81.63
  // and relative error < 2^-72.423 (see sollya/P_1.sollya).
  // The relative error is for x - x^2/2 + P(x) with respect to log(1+x).
  let w = DoubleDouble::from_exact_mult(z, z)
  let t = dd_fmla(fb(0xbfc0001f0c80e8ceUL), z, fb(0x3fc2494526fd4a06UL))
  let mut u = dd_fmla(fb(0xbfc55555553d1eb4UL), z, fb(0x3fc999999981f535UL))
  let mut v = dd_fmla(fb(0xbfd0000000000003UL), z, fb(0x3fd5555555555558UL))
  u = dd_fmla(t, w.hi, u)
  v = dd_fmla(u, w.hi, v)
  u = v * w.hi
  DoubleDouble::new(dd_fmla(u, z, -0.5 * w.lo), -0.5 * w.hi)
}

///|
/// Given 2^-1074 <= x <= 0x1.fffffffffffffp+1023, this routine puts in h+l
/// an approximation of log(x) such that |l| < 2^-23.89*|h| and
///
///   | h + l - log(x) | <= elog * |log x|
///
/// with elog = 2^-73.527  if x < 1/sqrt(2) or sqrt(2) < x,
/// and  elog = 2^-67.0544 if 1/sqrt(2) < x < sqrt(2)
/// (note that x cannot equal 1/sqrt(2) nor sqrt(2)).
fn pow_log_1(x : Double) -> (DoubleDouble, Bool) {
  let (e, t, idx) = log_reduce_inverse(x)
  let r = fb(pow_inverse[idx])
  let l1 = fb(pow_log_inv[2 * idx + 1])
  let l2 = fb(pow_log_inv[2 * idx])
  let z = dd_fmla(r, t, -1.0)
  let log2_dd = DoubleDouble::new(
    fb(0x3d2ef35793c76730UL),
    fb(0x3fe62e42fefa3800UL),
  )
  let th = dd_fmla(e.to_double(), log2_dd.hi, l1)
  let tl = dd_fmla(e.to_double(), log2_dd.lo, l2)
  let mut v = DoubleDouble::f64_add(th, DoubleDouble::new(tl, z))
  let p = log_poly_1(z)
  v = DoubleDouble::f64_add(v.hi, DoubleDouble::new(v.lo + p.lo, p.hi))
  if e == 0L && abs_f64(v.lo) > abs_f64(v.hi) * fb(0x3e70000000000000UL) {
    v = DoubleDouble::from_exact_add(v.hi, v.lo)
    return (v, true)
  }
  (v, false)
}

///|
/// Given z such that |z| < 2^-12.905,
/// this routine puts in qh+ql an approximation of exp(z) such that
///
///   | (qh+ql) / exp(z) - 1 | < 2^-64.902632
///
/// and |ql| <= 2^-51.999.
fn exp_poly_1(z : Double) -> DoubleDouble {
  let mut q = dd_fmla(fb(0x3fa5555555849d8dUL), z, fb(0x3fc5555555997996UL))
  q = dd_fmla(q, z, fb(0x3fe0000000000000UL))
  let h0 = dd_fmla(q, z, fb(0x3ff0000000000000UL))
  let v1 = DoubleDouble::from_exact_mult(z, h0)
  DoubleDouble::f64_add(fb(0x3ff0000000000000UL), v1)
}

///|
fn pow_exp_1(r : DoubleDouble, s : Double) -> DoubleDouble {
  let rho0 = fb(0xc0874910ee4e8a27UL)
  // We increase the initial value of RHO1 to avoid spurious underflow in
  // the result value el.
  let rho1 = fb(0xc08483b8cca421afUL)
  let rho2 = fb(0x40862e42e709a95bUL)
  let rho3 = fb(0x40862e4316ea5df9UL)
  // use !(rh <= RHO2) instead of rh < RHO2 to catch rh = NaN too
  if !(r.hi <= rho2) {
    return if r.hi > rho3 {
      // If rh > RHO3, we are sure there is overflow.
      DoubleDouble::new(
        fb(0x7fefffffffffffffUL) * s,
        fb(0x7fefffffffffffffUL) * s,
      )
    } else {
      // If RHO2 < rh <= RHO3, we are in the intermediate region where there
      // might be overflow or not: defer to the 2nd phase.
      DoubleDouble::new(nan_f64, nan_f64)
    }
  }
  if r.hi < rho1 {
    return if r.hi < rho0 {
      DoubleDouble::new(fb(0x0000000000000001UL) * (0.5 * s), 0.0 * s)
    } else {
      // RHO0 <= rh < RHO1 or s < 0: we defer to the 2nd phase
      DoubleDouble::new(nan_f64, nan_f64)
    }
  }
  let invlog2 = fb(0x40b71547652b82feUL)
  let k = round_f64(r.hi * invlog2)
  let log2h = fb(0x3f262e42fefa39efUL)
  let log2l = fb(0x3bbabc9e3b39803fUL)
  let zh = dd_fmla(log2h, -k, r.hi)
  let zl = dd_fmla(log2l, -k, r.lo)
  let bk = to_int_unchecked_i64(k) // Note: k is an integer, this is just a conversion.
  let mk = (bk >> 12) + 0x3ffL
  let i2 = ((bk >> 6) & 0x3fL).to_int()
  let i1 = (bk & 0x3fL).to_int()
  let t0 = DoubleDouble::from_table(exp_reduce_t0, i2)
  let t1 = DoubleDouble::from_table(exp_reduce_t1, i1)
  let mut de = DoubleDouble::quick_mult(t1, t0)
  let q = exp_poly_1(zh + zl)
  de = DoubleDouble::quick_mult(de, q)
  // we should have 1 < M < 2047 here, since we filtered out
  // potential underflow/overflow cases at the beginning of this function
  let mut du = mk.reinterpret_as_uint64() << 52
  du = tb(fb(du) * s)
  DoubleDouble::new(de.lo * fb(du), de.hi * fb(du))
}

///|
let exp_dyadic_q2 : FixedArray[DyadicFloat128] = [
  dyadic_const(false, -128, 0xffff_ffff_ffff_ffffUL, 0xffff_ffff_ffff_ffd0UL),
  dyadic_const(false, -127, 0x8000_0000_0000_0000UL, 0x0000_0000_0000_0088UL),
  dyadic_const(false, -128, 0x8000_0000_0000_0000UL, 0x0000_000c_06f3_cd29UL),
  dyadic_const(false, -130, 0xaaaa_aaaa_aaaa_aaaaUL, 0xaaaa_aa6a_1e07_76aeUL),
  dyadic_const(false, -132, 0xaaaa_aaaa_aaaa_aaa3UL, 0x0000_0000_0000_0000UL),
  dyadic_const(false, -134, 0x8888_8888_8888_8897UL, 0x0000_0000_0000_0000UL),
  dyadic_const(false, -137, 0xb60b_60b9_3214_6a54UL, 0x0000_0000_0000_0000UL),
  dyadic_const(false, -140, 0xd00d_00cd_9841_6862UL, 0x0000_0000_0000_0000UL),
]

///|
fn exp_dyadic_poly(x : DyadicFloat128) -> DyadicFloat128 {
  let mut p = exp_dyadic_q2[7]
  for i = 6; i >= 0; i = i - 1 {
    p = x * p + exp_dyadic_q2[i]
  }
  p
}

///|
let exp_dyadic_log2_inv : DyadicFloat128 = dyadic_const(
  false, -115, 0xb8aa_3b29_5c17_f0bcUL, 0x0000_0000_0000_0000UL,
)

///|
let exp_dyadic_log2 : DyadicFloat128 = dyadic_const(
  false, -128, 0xb172_17f7_d1cf_79abUL, 0xc9e3_b398_03f2_f6afUL,
)

///|
/// Put in r an approximation of exp(x), for |x| < 744.45,
/// with relative error < 2^-121.70.
fn exp_dyadic(x : DyadicFloat128) -> DyadicFloat128 {
  let ex = x.exponent + 127
  if ex >= 10 {
    // underflow or overflow
    return {
      neg: false,
      exponent: if x.neg {
        -1076
      } else {
        1025
      },
      hi: x.hi,
      lo: x.lo,
    }
  }
  let bk0 = x * exp_dyadic_log2_inv
  let k = bk0.trunc_to_i64() // k = trunc(K) [rounded towards zero, exact]
  let bk1 = exp_dyadic_log2.mul_int64(k)
  let bk : DyadicFloat128 = {
    neg: !bk1.neg,
    exponent: w16(bk1.exponent - 12),
    hi: bk1.hi,
    lo: bk1.lo,
  }
  let y = x + bk
  let bm = k >> 12
  let i2 = ((k >> 6) & 0x3fL).to_int()
  let i1 = (k & 0x3fL).to_int()
  let mut r = exp_dyadic_poly(y)
  r = exp_t1_2_dyadic[i2] * r
  r = exp_t2_2_dyadic[i1] * r
  {
    neg: r.neg,
    exponent: w16(r.exponent + w16(bm.to_int())),
    hi: r.hi,
    lo: r.lo,
  } // exact
}
