// Reference hashes produced by jxl-oxide's own (generic) implementation:
// FNV-1a over the f32 bit patterns of the outputs for LCG-generated inputs.

///|
struct Lcg {
  mut state : UInt32
}

///|
fn Lcg::next_raw(self : Lcg) -> UInt32 {
  self.state = self.state * 1664525U + 1013904223U
  self.state
}

///|
fn Lcg::next(self : Lcg) -> Float {
  Float::from_uint(self.next_raw() >> 8) / 16777216.0 * 2.0 - 1.0
}

///|
fn hash_floats(v : FixedArray[Float]) -> UInt32 {
  let mut h = 2166136261U
  for x in v {
    h = h ^ x.reinterpret_as_uint()
    h = h * 16777619U
  }
  h
}

